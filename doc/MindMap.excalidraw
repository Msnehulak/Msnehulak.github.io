    {
      "id": "LY7Y4rvC2mCfwuvgflQ42",
      "type": "text",
      "x": -1315.3686092657763,
      "y": 711.7683690455244,
      "width": 1042.13916015625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
